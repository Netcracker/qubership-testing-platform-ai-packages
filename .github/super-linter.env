# Loaded as environment variables by .github/workflows/super-linter.yaml.
# Each line must be name=value, sorted by name. This file replaces the common netcracker/.github one.
# A linter that is not listed here keeps super-linter's default: on, and it runs only when the
# repository holds files of its language.
# The *_PRETTIER linters are off; Markdown, YAML, and JSON files go through the MARKDOWN, YAML, and JSON linters.
# VALIDATE_GITHUB_ACTIONS_ZIZMOR is off; the workflows follow the neighboring repository's conventions instead.
# VALIDATE_BASH_EXEC is off because the bundled .sh files are not committed with the executable bit.

VALIDATE_BASH_EXEC=false
VALIDATE_BIOME_FORMAT=false
VALIDATE_BIOME_LINT=false
VALIDATE_CHECKOV=false
VALIDATE_CSS_PRETTIER=false
VALIDATE_EDITORCONFIG=false
VALIDATE_GITHUB_ACTIONS_ZIZMOR=false
VALIDATE_GITLEAKS=false
VALIDATE_GIT_COMMITLINT=false
VALIDATE_GOOGLE_JAVA_FORMAT=false
VALIDATE_GRAPHQL_PRETTIER=false
VALIDATE_HTML_PRETTIER=false
VALIDATE_JAVASCRIPT_PRETTIER=false
VALIDATE_JSCPD=false
VALIDATE_JSONC_PRETTIER=false
VALIDATE_JSON_PRETTIER=false
VALIDATE_JSX_PRETTIER=false
VALIDATE_MARKDOWN_PRETTIER=false
VALIDATE_SHELL_SHFMT=false
VALIDATE_TRIVY=false
VALIDATE_TSX_PRETTIER=false
VALIDATE_TYPESCRIPT_PRETTIER=false
VALIDATE_VUE_PRETTIER=false
VALIDATE_YAML_PRETTIER=false
